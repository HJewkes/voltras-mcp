// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`every coach fragment carries a source > pins every fragment text and source, so a wording change is a reviewed snapshot diff 1`] = `
{
  "accountability.ghost-nudge-1": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-ghost-client-followup-protocol",
    "text": "{{lifterName}}, the plan is sitting where you left it, and the door does not close.
{{nextUpLine}}
Pick a day that works and it goes on the plan, because a day you choose beats a day I would guess at.",
  },
  "accountability.ghost-nudge-2": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-ghost-client-followup-protocol",
    "text": "{{lifterName}}, short one.
{{nextUpLine}}
{{minutes}} minutes of it counts as done, because the plan recalculates from what actually happened rather than from what it asked for.
Say a day and it is scheduled, because a slot in the week holds better than an intention does.",
  },
  "accountability.holding-acknowledgement": {
    "sourceKind": "rp",
    "sourceRef": "rp-s11-unplanned-disruption-protocol, rp-s11-vacation-default-maintenance",
    "text": "{{lifterName}}, the hold you declared is still running{{throughClause}}, so the empty {{plannedDay}} slot is what the plan expects this week.
Nothing recalculates against a hold, and nothing is owed at the end of one.
{{maintenanceLine}}",
  },
  "accountability.miss-recovery": {
    "sourceKind": "engineering-default",
    "sourceRef": "One re-entry offer on a named day is inspired by, not established by, the 2021 exercise megastudy, whose winner rewarded returning after a miss; the link is unverified.",
    "text": "{{lifterName}}, the {{plannedDay}} session ({{missedExercises}}) is not in the records, and its named fallback on {{fallbackDay}} has passed.
{{nonJudgmentLine}}
{{operationalHonestyLine}}
{{offerLine}}
{{bookingLine}}",
  },
  "accountability.non-judgment": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-lying-about-compliance-response",
    "text": "No judgment in this, and none implied.",
  },
  "accountability.operational-honesty": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-lying-about-compliance-response",
    "text": "The reason accuracy matters here is operational, not moral: the plan cannot autoregulate load and volume correctly from records that do not match what happened.",
  },
  "accountability.realign-opener": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-noncompliance-escalation-ladder, rp-s5-frequency-progression-conservative",
    "text": "{{lifterName}}, one conversation about the shape of the week, not a verdict on it.
{{nonJudgmentLine}}
{{operationalHonestyLine}}
{{adherenceLine}}
{{rollingLine}}
{{reArchitectLine}}
{{askLine}}",
  },
  "accountability.silence-means-on-track": {
    "sourceKind": "engineering-default",
    "sourceRef": "Silence only informs if its meaning was stated once; the mid-week quiet is a product choice with no corpus or paper claim behind the wording.",
    "text": "You will not hear from me mid-week unless a planned session goes unrecorded, so silence through the week means the plan is on track.",
  },
  "accountability.sunday-anchor": {
    "sourceKind": "rp",
    "sourceRef": "rp-s10-checkin-cadence",
    "text": "{{lifterName}}, it is Sunday. Here is last week as the records have it, rather than a question about how it went.
{{adherenceLine}}
{{rollingLine}}
{{nextUpLine}}
{{planningLine}}
{{slotsLine}}
{{ifThenLine}}
{{commitmentLine}}
{{silenceLine}}",
  },
  "calibration.baseline.cold": {
    "sourceKind": "engineering-default",
    "sourceRef": "A cold baseline needs enough working sets to read the lift’s rep pattern.",
    "text": "more working sets of this lift",
  },
  "calibration.baseline.shape-only": {
    "sourceKind": "engineering-default",
    "sourceRef": "A shape-only baseline needs one set near failure before it can place the lifter’s ceiling.",
    "text": "a set taken near failure",
  },
  "calibration.recalibration-offered": {
    "sourceKind": "engineering-default",
    "sourceRef": "Offers the data-based target without swapping it in, so the lifter decides whether to take it.",
    "text": "Calibrated. Your goal is still the starting ramp; a target based on your lifts is ready.",
  },
  "calibration.session-count.many": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "{{needed}} more comparable sessions",
  },
  "calibration.session-count.one": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "{{needed}} more comparable session",
  },
  "calibration.starting-ramp": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "Starting ramp, not yet based on your lifts.",
  },
  "calibration.wait.baseline": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "Calibrates after {{baseline}}.",
  },
  "calibration.wait.both": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "Calibrates after {{sessions}} and {{baseline}}.",
  },
  "calibration.wait.sessions": {
    "sourceKind": "engineering-default",
    "sourceRef": "Says what a calibrating goal still waits on, so a starting ramp never reads as a target based on the lifter’s own lifts.",
    "text": "{{sessions}} to calibrate.",
  },
  "composer.adherence-none": {
    "sourceKind": "engineering-default",
    "sourceRef": "An empty calendar is not a shortfall, so the line says there is nothing to compare.",
    "text": "Nothing was on the calendar last week, so there is no planned-versus-recorded read to show.",
  },
  "composer.adherence-read": {
    "sourceKind": "engineering-default",
    "sourceRef": "Shows last week as the records have it rather than asking how it went; the wording is ours.",
    "text": "Planned {{planned}}, recorded {{done}}. Deviation trend: {{trend}}.",
  },
  "composer.ask": {
    "sourceKind": "engineering-default",
    "sourceRef": "Asks for the one failing slot so the fix is the smallest change that could work.",
    "text": "Tell me which of {{dayList}} is the slot that keeps breaking and I will rebuild the week around the ones that hold, because moving one slot is a smaller change than moving the plan.",
  },
  "composer.booking": {
    "sourceKind": "engineering-default",
    "sourceRef": "Puts the re-entry on a named day; inspired by, not established by, the if-then research, which tested plans people wrote themselves rather than a booked slot.",
    "text": "Reply with a yes and it goes on the plan for {{reEntryDay}}, because a booked slot defends itself better than an intention does.",
  },
  "composer.holding-maintenance": {
    "sourceKind": "engineering-default",
    "sourceRef": "An optional session during a hold is inspired by, not established by, the RP rule that travel defaults to maintenance; the claim about less work is not from that rule.",
    "text": "If you want to keep a hand in while it runs, one option is {{minutes}} minutes of {{exercise}} on whichever day suits{{loadClause}}, because holding a position takes far less work than building it did.",
  },
  "composer.holding-through": {
    "sourceKind": "engineering-default",
    "sourceRef": "Names the end of a dated hold so the lifter can see when normal cadence resumes.",
    "text": " through {{endDate}}",
  },
  "composer.if-then-first": {
    "sourceKind": "paper",
    "sourceRef": "Supports asking each week for an if-then plan that names the expected barrier, not the closing reason that a self-written plan holds, which is ours: Silva et al. 2018, https://doi.org/10.1371/journal.pone.0206294; Belanger-Gravel et al. 2013, https://doi.org/10.1080/17437199.2011.560095",
    "text": "This week's if-then is yours to write, in the shape of "if this gets in the way, then that slot moves here", so send it in your own words, because a plan you wrote yourself is the one that holds when the week pushes back.",
  },
  "composer.if-then-repeat": {
    "sourceKind": "paper",
    "sourceRef": "Supports asking each week for an if-then plan that names the expected barrier, not the closing reason that a self-written plan holds, which is ours: Silva et al. 2018, https://doi.org/10.1371/journal.pone.0206294; Belanger-Gravel et al. 2013, https://doi.org/10.1080/17437199.2011.560095",
    "text": "Your if-then from last week was: "{{ifThenPlan}}". Send this week's version with the barrier you actually expect named in it, because a plan you wrote yourself is the one that holds when the week pushes back.",
  },
  "composer.load-clause": {
    "sourceKind": "engineering-default",
    "sourceRef": "States the planned load so a short re-entry does not read as a cue to lighten it.",
    "text": ", load held at {{weightLbs}} lb",
  },
  "composer.month-marker": {
    "sourceKind": "engineering-default",
    "sourceRef": "A self-authored monthly target is inspired by, not established by, Royer et al. 2015 on commitment contracts; the self-authored detail is unverified.",
    "text": "Month marker: the target in your own words is "{{wording}}", and restating or revising it is yours to do, because a number I pick for you is not a commitment.",
  },
  "composer.next-up": {
    "sourceKind": "engineering-default",
    "sourceRef": "A readout of the queued workout, so the message points at a concrete next session.",
    "text": "Next on the plan: {{templateName}}, with {{exercises}}.",
  },
  "composer.next-up-empty": {
    "sourceKind": "engineering-default",
    "sourceRef": "Names the gap and the small cost of closing it, with no evaluation of the lifter.",
    "text": "Nothing is queued on the plan right now, which is ten minutes of programming whenever you want it.",
  },
  "composer.planning": {
    "sourceKind": "engineering-default",
    "sourceRef": "Offers the planning sitting without starting it, so the lifter picks when; the wording is ours.",
    "text": "The next block is due to be planned: {{reason}} Pick a time this week to plan it with me, because a block dated before it starts is one the week can be built around.",
  },
  "composer.re-architect": {
    "sourceKind": "rp",
    "sourceRef": "rp-s5-frequency-progression-conservative",
    "text": "If the week is genuinely fuller than the plan assumes, the fix is re-architecting to your real schedule: keep {{days}} days and move {{dayList}} to the hours that actually exist, renaming each fallback as you go, within {{days}} days rather than down from them, because {{days}} days is the frequency your training tier holds before any change to it is worth making.",
  },
  "composer.re-entry-offer": {
    "sourceKind": "engineering-default",
    "sourceRef": "A small re-entry on a named day is inspired by, not established by, the 2021 exercise megastudy, whose winner rewarded returning after a miss; the link is unverified.",
    "text": "One way back in, smaller than the plan asks for: {{reEntryDay}}, {{minutes}} minutes, run {{exercise}} plus one accessory{{loadClause}}, because a short session that happens is what the next progression reads from.",
  },
  "composer.rolling": {
    "sourceKind": "engineering-default",
    "sourceRef": "A rolling count has no zero state to break, which is inspired by, not established by, Silverman and Barasch 2023 on broken streaks; the 28-day window is ours.",
    "text": "Rolling 28-day training days: {{trainingDays}}.",
  },
  "composer.slot": {
    "sourceKind": "engineering-default",
    "sourceRef": "Each planned day is shown with its named fallback so a moved session still counts.",
    "text": "{{day}} (fallback {{fallbackDay}})",
  },
  "composer.slots": {
    "sourceKind": "engineering-default",
    "sourceRef": "Confirms the week with a fallback per slot; no cited claim sets this wording.",
    "text": "Slots for the coming week, each with its named fallback: run {{slots}}, because a session on its fallback day counts as recorded, which is the whole point of naming fallbacks.",
  },
  "composer.trend.declining": {
    "sourceKind": "engineering-default",
    "sourceRef": "Trend reads as a direction, never a raw deviation count, because a count is the running total the copy rules ban.",
    "text": "worsening",
  },
  "composer.trend.improving": {
    "sourceKind": "engineering-default",
    "sourceRef": "Trend reads as a direction, never a raw deviation count, because a count is the running total the copy rules ban.",
    "text": "improving",
  },
  "composer.trend.no-prior": {
    "sourceKind": "engineering-default",
    "sourceRef": "Trend reads as a direction, never a raw deviation count, because a count is the running total the copy rules ban.",
    "text": "no prior week to compare",
  },
  "composer.trend.steady": {
    "sourceKind": "engineering-default",
    "sourceRef": "Trend reads as a direction, never a raw deviation count, because a count is the running total the copy rules ban.",
    "text": "flat",
  },
  "cue.set-complete.1": {
