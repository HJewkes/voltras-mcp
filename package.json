{
  "name": "voltras-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing Voltra device control, session recording, history, and analytics as tools and resources for Claude.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "voltras-mcp": "./dist/bin.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "scripts/ensure-whisper.mjs",
    "scripts/lib/whisper-paths.mjs"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:spa",
    "build:dashboard": "vite build --config src/dashboard/spa/vite.config.ts",
    "start": "node ./dist/bin.js",
    "dashboard:sim": "node scripts/dashboard-sim.mjs",
    "postinstall": "node scripts/ensure-whisper.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit && npm run typecheck:spa && npm run typecheck:tests",
    "typecheck:spa": "tsc -p src/dashboard/spa/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,cjs,json}\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.mjs\"",
    "prepare": "husky",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:reference": "node scripts/gen-tool-reference.mjs",
    "docs:captures": "node scripts/capture-screens.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/nunito-sans": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@voltras/node-sdk": "^0.14.0",
    "@voltras/workout-analytics": "^2.3.0",
    "node-record-lpcm16": "^1.0.1",
    "nodejs-whisper": "^0.3.0",
    "onnxruntime-node": "^1.27.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@react-native/assets-registry": "^0.83.10",
    "@titan-design/react-ui": "^0.12.0",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.23.0",
    "nativewind": "^4.2.6",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.86.0",
    "react-native-web": "^0.19.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "voltras",
    "voltra",
    "fitness",
    "ble"
  ],
  "license": "MIT"
}
