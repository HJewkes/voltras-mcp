#!/usr/bin/env bash
# voltra-pt — launch Claude Code with the Voltra MCP wired up for a PT session.
#
# Enables the experimental claude/channel capability on the voltras MCP server
# so push events (rep_finalized, set_target_reached, timer_complete, etc.) are
# delivered inline as <channel> tags instead of forcing the model to poll.
#
# Defaults to an initial prompt that triggers the pt-session skill if it's
# installed. Override by passing your own prompt as an argument:
#
#   voltra-pt                          # start with the default PT prompt
#   voltra-pt "do a chest fly workout" # custom prompt
#   voltra-pt --print "list my sessions today"  # non-interactive query
#
# Set VOLTRA_PT_PROMPT to change the default without touching this script.
#
# Two launch modes:
#
#   plugin mode (default) — runs the server as the voltras-channel plugin from
#     the voltras-local marketplace and passes `--channels`. This needs the
#     plugin installed AND the plugin allowlisted in machine-wide managed
#     settings; see docs/channel-plugin-packaging.md.
#
#   dev mode (VOLTRA_PT_DEV=1) — the original path: registers nothing, and
#     passes --dangerously-load-development-channels for a `claude mcp add`ed
#     `voltras` server. Use this if the managed-settings file isn't installed.

set -euo pipefail

PLUGIN_NAME="voltras-channel"
MARKETPLACE_NAME="voltras-local"
CHANNEL_ENTRY="plugin:${PLUGIN_NAME}@${MARKETPLACE_NAME}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v claude >/dev/null 2>&1; then
  echo "voltra-pt: 'claude' CLI not on PATH." >&2
  echo "Install Claude Code first: https://code.claude.com" >&2
  exit 127
fi

if [ "${VOLTRA_PT_DEV:-0}" = "1" ]; then
  if ! claude mcp list 2>&1 | grep -qE '^voltras:'; then
    cat >&2 <<'EOF'
voltra-pt: voltras MCP server is not registered with Claude Code.

Register it first:
  claude mcp add voltras -- voltras-mcp           # local install (npm link)
  claude mcp add voltras -- npx voltras-mcp       # published package

Then re-run voltra-pt.
EOF
    exit 1
  fi
  CHANNEL_FLAG=(--dangerously-load-development-channels "server:voltras")
else
  if ! claude plugin list 2>/dev/null | grep -q "${PLUGIN_NAME}@${MARKETPLACE_NAME}"; then
    cat >&2 <<EOF
voltra-pt: the ${PLUGIN_NAME} plugin is not installed.

Install it from this repo:
  claude plugin marketplace add ${REPO_ROOT}
  claude plugin install ${PLUGIN_NAME}@${MARKETPLACE_NAME}

Or set VOLTRA_PT_DEV=1 to use the development-channel flag instead.
EOF
    exit 1
  fi

  # The plugin ships the MCP server too, so a separate `claude mcp add voltras`
  # would spawn a second process against the same SQLite file and dashboard
  # port. See "Running more than one instance" in the README.
  if claude mcp list 2>&1 | grep -qE '^voltras:'; then
    cat >&2 <<'EOF'
voltra-pt: both the voltras-channel plugin and a standalone `voltras` MCP
server are registered. They would run two server processes against the same
database and dashboard port.

Remove the standalone registration:
  claude mcp remove voltras
EOF
    exit 1
  fi

  # Lets the plugin's launch shim find this checkout's dist/bin.js.
  export VOLTRAS_MCP_HOME="$REPO_ROOT"
  CHANNEL_FLAG=(--channels "$CHANNEL_ENTRY")
fi

DEFAULT_PROMPT="Start a PT session. I'm ready to lift."
INITIAL_PROMPT="${VOLTRA_PT_PROMPT:-$DEFAULT_PROMPT}"

# The channel flags take a variadic list (`<servers...>`), so they swallow any
# positional that follows them — the prompt included. Keep them last.
if [ "$#" -gt 0 ]; then
  exec claude "$@" "${CHANNEL_FLAG[@]}"
else
  exec claude "$INITIAL_PROMPT" "${CHANNEL_FLAG[@]}"
fi
