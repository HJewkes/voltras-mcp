{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".store-build",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "scripts/store/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    ".store-build",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/dashboard/spa"
  ]
}
