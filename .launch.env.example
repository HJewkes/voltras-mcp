# Copy to .launch.env (gitignored) and uncomment what you want to override.
# Sourced by plugins/voltras-channel/bin/voltras-mcp-launch.sh when present at
# the repo root — every variable set here is exported into the launched
# server's environment. Full descriptions: README "Environment variables".
#
# Never put a real secret in a file named .launch.env.example — this file is
# committed. Real TrueCoach credentials belong only in your own .launch.env.

# BLE adapter: "node" (real hardware) or "mock" (in-process, no BLE).
#VOLTRA_ADAPTER=node

# Dashboard sidecar port. A number, "off" to disable, or "0" for an
# OS-assigned port.
#VMCP_DASHBOARD_PORT=7723

# SQLite store path. Keep this distinct per concurrently running instance.
#VMCP_DB_PATH=~/.voltras/vmcp.sqlite

# Log verbosity: debug | info | warn | error. Logs go to stderr only.
#VMCP_LOG_LEVEL=info

# Deterministic spoken coaching cues (macOS `say` only).
#VMCP_CUES=off

# Whether cues may speak while a rep is still under load (mutes voice "stop"
# for that window — see README before enabling).
#VMCP_CUES_MIDSET=off

# Auto-arm the passive rest_status push cycle on a natural set close.
#VMCP_REST_TIMER=off

# Open a set on the server's own initiative when reps land outside one.
#VMCP_AUTO_ARM=on

# Rep pipeline: analytics | firmware. firmware is a dark flag pending a
# hardware cutover.
#VMCP_REP_SOURCE=analytics

# Movement-class-dependent rep-segmentation corrections. Dark until validated.
#VMCP_REP_CORRECTIONS=off

# Where persisted device <-> left/right slot bindings live.
#VMCP_SLOT_BINDINGS_PATH=~/.voltras/slot-bindings.json

# Capacity of the in-memory diagnostic ring buffer behind debug.recent_frames
# / debug.recent_events.
#VMCP_DEBUG_BUFFER_SIZE=256

# TrueCoach account email. Leave unset unless you use the pull/write-back.
#VMCP_TRUECOACH_USERNAME=

# TrueCoach password, plaintext in the environment. Prefer
# VMCP_TRUECOACH_PASSWORD_CMD (a command whose stdout is the password) so the
# real secret can stay in the macOS keychain instead of this file.
#VMCP_TRUECOACH_PASSWORD=
#VMCP_TRUECOACH_PASSWORD_CMD=

# Override for the TrueCoach client id (set only if the pull 404s).
#VMCP_TRUECOACH_CLIENT_ID=

# Cached access token path (written mode 0600) and raw response cache dir.
#VMCP_TRUECOACH_TOKEN_PATH=~/.voltras/truecoach-token.json
#VMCP_TRUECOACH_CACHE_DIR=~/.voltras/truecoach-cache

# Write rendered coach results to the local outbox on session.end.
#VMCP_TRUECOACH_OUTBOX=off
#VMCP_TRUECOACH_OUTBOX_DIR=~/.voltras/truecoach-outbox

# Also submit the outbox entry via tools/truecoach-submit once, detached. Read
# "TrueCoach write-back (unattended, gated)" in the README before enabling.
#VMCP_TRUECOACH_SUBMIT_ON_END=off
