# Dependencies
node_modules/

# Build output
dist/

# Test / coverage
coverage/
*.lcov

# Local SQLite databases (default $VMCP_DB_PATH lives in $HOME/.voltras/)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.*
!.env.example
.launch.env
!.launch.env.example

# TrueCoach pull: the cached access token (mode 0600) and the raw response
# cache. Both live under $HOME by default; these entries cover a run that
# points VMCP_TRUECOACH_TOKEN_PATH / VMCP_TRUECOACH_CACHE_DIR into the repo.
truecoach-token.json
truecoach-cache/
.worktrees/

# Cross-session working notes (kept on disk, not tracked)
HANDOFF.md

# Python venv for the voice-listener sidecar (created by scripts/setup-voice.sh)
voice-listener/.venv/

# Docs site build output (VitePress)
site/.vitepress/dist/
site/.vitepress/cache/
